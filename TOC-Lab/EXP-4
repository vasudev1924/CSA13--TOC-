#include <stdio.h>
#include <string.h>

int main() {
    char str[100];
    int valid = 1;

    printf("Enter a binary string: ");
    scanf("%99s", str);

    int len = strlen(str);

    if (len < 2 || str[0] != '0' || str[len - 1] != '1') {
        valid = 0;
    } else {
        for (int i = 0; i < len; i++) {
            if (str[i] != '0' && str[i] != '1') {
                valid = 0;
                break;
            }
        }
    }

    if (valid)
        printf("String Accepted");
    else
        printf("String Rejected");

    return 0;
}
