#include <stdio.h>

int n, trans[10][10], closure[10][10];

void findClosure(int state, int current) {
    for (int j = 0; j < n; j++) {
        if (trans[current][j] && !closure[state][j]) {
            closure[state][j] = 1;
            findClosure(state, j);
        }
    }
}

int main() {
    int e, from, to;

    printf("Enter number of states: ");
    scanf("%d", &n);

    printf("Enter number of epsilon transitions: ");
    scanf("%d", &e);

    for (int i = 0; i < e; i++) {
        printf("Enter transition (from to): ");
        scanf("%d %d", &from, &to);
        trans[from][to] = 1;
    }

    for (int i = 0; i < n; i++) {
        closure[i][i] = 1;
        findClosure(i, i);
    }

    for (int i = 0; i < n; i++) {
        printf("Epsilon-closure(q%d) = { ", i);
        for (int j = 0; j < n; j++) {
            if (closure[i][j])
                printf("q%d ", j);
        }
        printf("}\n");
    }

    return 0;
}
