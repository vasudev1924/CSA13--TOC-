#include <stdio.h>
#include <string.h>

int main() {
    char str[100];

    printf("Enter a binary string: ");
    scanf("%99s", str);

    int len = strlen(str);

    if (str[0] == '0' && str[len - 1] == '1')
        printf("String Accepted");
    else
        printf("String Rejected");

    return 0;
}
